      Parameter {
        Variable      "Declarations"
        Value         "#include <math.h>\n"
"\n"
"#define sd_m InputSignal(0,0);\n"
"\n"
"#define Ts_m InputSignal(1,0);\n"
"#define fc_m InputSignal(1,1);\n"
"\n"
"#define pi 3.14159265358979323846\n"
"\n"
"// Inputs.\n"
"float sd_in;\n"
"\n"
"float Ts;\n"
"float fc;\n"
"\n"
"// Output. \n"
"float sd_out;\n"
"float sd_prev;\n"
"\n"
"float alpha; "
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "sd_prev = 0;"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "sd_in = sd_m;\n"
"\n"
"Ts = Ts_m;\n"
"fc = fc_m;\n"
"\n"
"alpha = exp(-2*pi*fc*Ts);\n"
"sd_out = alpha * sd_prev + (1.0 - alpha) * sd_in;\n"
"\n"
"OutputSignal(0,0) = sd_out;\n"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         "sd_prev = sd_out;"
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
